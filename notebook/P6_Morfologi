{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyNW9cTb8L+3Za9oWubF0PFd"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","execution_count":1,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"dQc1rbWNKdXx","executionInfo":{"status":"ok","timestamp":1794985780205,"user_tz":-420,"elapsed":28004,"user":{"displayName":"Muhammad Aditya Genta Andhara","userId":"01260930399325567728"}},"outputId":"6c0550b1-f502-4b96-ad28-94cb5cac5128"},"outputs":[{"output_type":"stream","name":"stdout","text":["Mounted at /content/drive\n"]}],"source":["from google.colab import drive\n","drive.mount('/content/drive')"]},{"cell_type":"code","source":["# Kode 1.1 Persiapan: modul, data, praproses, dan tepi acuan\n","import sys, json\n","sys.path.append(\"/content/drive/MyDrive/simuteh-2330511092/src\")\n","import cv2, numpy as np, pandas as pd, matplotlib.pyplot as plt\n","from utils_cv import baca, tampil\n","from praproses import praproses\n","from utils_tepi import tepi_acuan, skor_tepi, iou, mask_daun_awal, bercak_awal\n","\n","pd.set_option(\"display.width\", 160); pd.set_option(\"display.max_columns\", 20)\n","# Memuat parameter hasil Evaluasi P1-P4\n","PARAM = json.load(open(\"/content/drive/MyDrive/simuteh-2330511092/hasil/param_praproses.json\"))\n","label = pd.read_csv(\"/content/drive/MyDrive/simuteh-2330511092/data/sintetis/label.csv\")\n","\n","def muat(nama):\n","    img = baca(f\"/content/drive/MyDrive/simuteh-2330511092/data/sintetis/citra/{nama}\")\n","    md = cv2.imread(f\"/content/drive/MyDrive/simuteh-2330511092/data/sintetis/mask_daun/{nama}\", 0)\n","    mb = cv2.imread(f\"/content/drive/MyDrive/simuteh-2330511092/data/sintetis/mask_bercak/{nama}\", 0)\n","    return img, md, mb\n","\n","img, md, mb = muat(\"teh_041.png\")\n","pra = praproses(img, PARAM)\n","\n","acuan = cv2.bitwise_or(tepi_acuan(md), tepi_acuan(mb))\n","tampil([img, pra, acuan], [\"Citra mentah\", \"Sesudah praproses\", \"Tepi acuan (daun + bercak)\"])"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":247},"id":"8FTnxAixMSvt","executionInfo":{"status":"ok","timestamp":1794985795195,"user_tz":-420,"elapsed":6713,"user":{"displayName":"Muhammad Aditya Genta Andhara","userId":"01260930399325567728"}},"outputId":"7944e131-e34a-453c-a7fb-093264940044"},"execution_count":2,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1400x400 with 3 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["# Kode 1.3 Fungsi Sobel, Prewitt, LoG, dan Canny serta perbandingannya\n","def tepi_sobel(g, T=100):\n","    g = g.astype(np.float32)\n","    m = np.hypot(cv2.Sobel(g, cv2.CV_32F, 1, 0), cv2.Sobel(g, cv2.CV_32F, 0, 1))\n","    return ((m > T) * 255).astype(np.uint8)\n","\n","def tepi_prewitt(g, T=75):\n","    kx = np.array([[-1, 0, 1], [-1, 0, 1], [-1, 0, 1]], np.float32)\n","    g = g.astype(np.float32)\n","    m = np.hypot(cv2.filter2D(g, -1, kx), cv2.filter2D(g, -1, kx.T))\n","    return ((m > T) * 255).astype(np.uint8)\n","\n","def tepi_log(g, sigma=3.0, frac=0.2):\n","    \"\"\"Laplacian of Gaussian: tepi = perlintasan nol yang cukup kuat.\"\"\"\n","    L = cv2.Laplacian(cv2.GaussianBlur(g.astype(np.float32), (0, 0), sigma), cv2.CV_32F)\n","    mn, mx = cv2.erode(L, np.ones((3, 3))), cv2.dilate(L, np.ones((3, 3)))\n","    return (((mn < 0) & (mx > 0) & (mx - mn > frac * np.abs(L).max())) * 255).astype(np.uint8)\n","\n","def tepi_canny(g, lo=30, hi=90, sigma=2.0):\n","    if sigma > 0:\n","        g = cv2.GaussianBlur(g, (0, 0), sigma)\n","    return cv2.Canny(g, lo, hi)\n","\n","metode = {\"Sobel\": tepi_sobel, \"Prewitt\": tepi_prewitt, \"LoG\": tepi_log, \"Canny\": tepi_canny}\n","g = pra[:, :, 2]\n","hasil = {nm: f(g) for nm, f in metode.items()}\n","tampil(list(hasil.values()), [f\"{nm}  P/R/F1={skor_tepi(e, acuan)}\" for nm, e in hasil.items()],\n","       ukuran=(17, 3.6))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":191},"id":"2lnSk5yAMqkn","executionInfo":{"status":"ok","timestamp":1794985819046,"user_tz":-420,"elapsed":1268,"user":{"displayName":"Muhammad Aditya Genta Andhara","userId":"01260930399325567728"}},"outputId":"3b130fe4-b3c8-4b8d-dc98-16d9e9a5fe45"},"execution_count":3,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1700x360 with 4 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["# Kode 3.1 Mask daun awal dan bercak awal\n","def jumlah_komponen(m, konek=8):\n","    return cv2.connectedComponents((m > 0).astype(np.uint8), connectivity=konek)[0] - 1\n","\n","baris, panel, judul = [], [], []\n","for nama in [\"teh_041.png\", \"teh_021.png\", \"teh_011.png\"]:   # berat, ringan, sehat\n","    img, md, mb = muat(nama)\n","    pra_ = praproses(img, PARAM)\n","    m_daun = mask_daun_awal(pra_)\n","    b0 = bercak_awal(pra_, m_daun, kanal=2, k=4.0)\n","    baris.append([nama, round(iou(m_daun, md), 3), jumlah_komponen(b0), jumlah_komponen(mb),\n","                  round(iou(b0, mb), 3) if mb.any() else \"-\"])\n","    panel += [pra_, b0, mb]; judul += [nama[:7], \"bercak awal\", \"mask bercak acuan\"]\n","\n","print(pd.DataFrame(baris, columns=[\"citra\", \"IoU daun awal\", \"komponen bercak awal\",\n","                                   \"komponen acuan\", \"IoU bercak awal\"]))\n","tampil(panel, judul, baris=3, ukuran=(14, 10))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":722},"id":"21VyKR4uK_K6","executionInfo":{"status":"ok","timestamp":1794985827276,"user_tz":-420,"elapsed":4111,"user":{"displayName":"Muhammad Aditya Genta Andhara","userId":"01260930399325567728"}},"outputId":"5b1de31d-4509-40e6-d590-f61529ba2a63"},"execution_count":4,"outputs":[{"output_type":"stream","name":"stdout","text":["         citra  IoU daun awal  komponen bercak awal  komponen acuan IoU bercak awal\n","0  teh_041.png          0.991                    77               8           0.736\n","1  teh_021.png          0.994                   113               2           0.137\n","2  teh_011.png          0.993                   288               0               -\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1400x1000 with 9 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["# Kode 3.2 Erosi, dilasi, opening, dan closing\n","SE = lambda k, bentuk=cv2.MORPH_ELLIPSE: cv2.getStructuringElement(bentuk, (k, k))\n","\n","def operasi(b, se):\n","    return {\"awal\": b,\n","            \"erosi\": cv2.erode(b, se),\n","            \"dilasi\": cv2.dilate(b, se),\n","            \"opening\": cv2.morphologyEx(b, cv2.MORPH_OPEN, se),\n","            \"closing\": cv2.morphologyEx(b, cv2.MORPH_CLOSE, se),\n","            \"open+close\": cv2.morphologyEx(cv2.morphologyEx(b, cv2.MORPH_OPEN, se), cv2.MORPH_CLOSE, se)}\n","\n","baris = []\n","for nama in [\"teh_021.png\", \"teh_011.png\"]:\n","    img, md, mb = muat(nama)\n","    pra_ = praproses(img, PARAM)\n","    b0 = bercak_awal(pra_, mask_daun_awal(pra_))\n","    hasil = operasi(b0, SE(5))\n","    for nm, m in hasil.items():\n","        baris.append([nama, nm, jumlah_komponen(m), int((m > 0).sum()),\n","                      round(iou(m, mb), 3) if mb.any() else \"-\"])\n","    tampil(list(hasil.values()), list(hasil.keys()), ukuran=(18, 3)); plt.show()\n","\n","print(pd.DataFrame(baris, columns=[\"citra\", \"operasi\", \"komponen\", \"piksel\", \"IoU\"]))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":483},"id":"iFzpcgv5mbPM","executionInfo":{"status":"ok","timestamp":1794985841590,"user_tz":-420,"elapsed":1174,"user":{"displayName":"Muhammad Aditya Genta Andhara","userId":"01260930399325567728"}},"outputId":"87714bef-a92d-45b8-b10d-0db590b3f66d"},"execution_count":5,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1800x300 with 6 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<Figure size 1800x300 with 6 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["          citra     operasi  komponen  piksel    IoU\n","0   teh_021.png        awal       113    1493  0.137\n","1   teh_021.png       erosi        19     157  0.293\n","2   teh_021.png      dilasi        58    4843   0.06\n","3   teh_021.png     opening        12     613  0.303\n","4   teh_021.png     closing       108    1575   0.13\n","5   teh_021.png  open+close        12     613  0.303\n","6   teh_011.png        awal       288    2772      -\n","7   teh_011.png       erosi        17     542      -\n","8   teh_011.png      dilasi        54    9197      -\n","9   teh_011.png     opening         2    1959      -\n","10  teh_011.png     closing       278    2844      -\n","11  teh_011.png  open+close         1    1966      -\n"]}]},{"cell_type":"code","source":["# Kode 3.3 Eksperimen k, bentuk, dan ukuran SE\n","bentuk = {\"persegi\": cv2.MORPH_RECT, \"elips\": cv2.MORPH_ELLIPSE, \"silang\": cv2.MORPH_CROSS}\n","baris = []\n","for _, d in label.iterrows():\n","    img, md, mb = muat(d.nama_file)\n","    pra_ = praproses(img, PARAM)\n","    m_daun = mask_daun_awal(pra_)\n","    n_acuan = jumlah_komponen(mb)\n","    for k in [3, 4, 6]:\n","        b0 = bercak_awal(pra_, m_daun, k=k)\n","        for nb, kb in bentuk.items():\n","            for uk in [3, 5, 7]:\n","                se = SE(uk, kb)\n","                m = cv2.morphologyEx(cv2.morphologyEx(b0, cv2.MORPH_OPEN, se), cv2.MORPH_CLOSE, se)\n","                baris.append([d.kelas, k, nb, uk, abs(jumlah_komponen(m) - n_acuan),\n","                              iou(m, mb) if mb.any() else np.nan])\n","\n","eks = pd.DataFrame(baris, columns=[\"kelas\", \"k\", \"bentuk\", \"ukuran\", \"galat_jumlah\", \"IoU\"])\n","print(eks.pivot_table(index=[\"k\", \"bentuk\", \"ukuran\"], columns=\"kelas\",\n","                      values=[\"galat_jumlah\", \"IoU\"]).round(2))\n","eks.to_csv(\"/content/drive/MyDrive/simuteh-2330511092/hasil/p6_eksperimen_se.csv\", index=False)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"sn41jWrBn4bK","executionInfo":{"status":"ok","timestamp":1794985909285,"user_tz":-420,"elapsed":59999,"user":{"displayName":"Muhammad Aditya Genta Andhara","userId":"01260930399325567728"}},"outputId":"92975d42-b81f-43c2-919a-cdf0636d5b57"},"execution_count":6,"outputs":[{"output_type":"stream","name":"stdout","text":["                   IoU        galat_jumlah              \n","kelas            berat ringan        berat ringan  sehat\n","k bentuk  ukuran                                        \n","3 elips   3       0.63   0.14        27.45  18.80  26.65\n","          5       0.69   0.22         2.50   3.00   4.70\n","          7       0.79   0.38         1.60   2.85   3.15\n","  persegi 3       0.65   0.16         6.55   8.15   8.15\n","          5       0.73   0.27         2.10   3.85   3.95\n","          7       0.79   0.49         0.45   0.70   0.00\n","  silang  3       0.63   0.14        27.45  18.80  26.65\n","          5       0.69   0.21         5.35   6.05   6.45\n","          7       0.79   0.35         2.05   5.20   5.90\n","4 elips   3       0.69   0.25        18.15   8.55  11.80\n","          5       0.73   0.32         2.25   4.55   3.65\n","          7       0.76   0.53         0.45   0.90   0.85\n","  persegi 3       0.70   0.27         5.40   4.75   6.70\n","          5       0.75   0.41         1.05   2.65   2.70\n","          7       0.75   0.46         0.50   0.65   0.00\n","  silang  3       0.69   0.25        18.15   8.55  11.80\n","          5       0.74   0.31         4.50   7.55   7.00\n","          7       0.76   0.44         0.65   1.80   1.75\n","6 elips   3       0.70   0.43         4.65   6.50   5.55\n","          5       0.70   0.49         0.50   1.10   0.65\n","          7       0.70   0.49         0.60   0.45   0.00\n","  persegi 3       0.70   0.45         1.45   3.60   3.30\n","          5       0.70   0.49         0.45   0.40   0.00\n","          7       0.68   0.38         0.90   0.85   0.00\n","  silang  3       0.70   0.43         4.65   6.50   5.55\n","          5       0.70   0.47         0.50   1.65   1.15\n","          7       0.69   0.43         0.50   0.50   0.00\n"]}]},{"cell_type":"code","source":["# Kode 3.4 Gradien morfologi dibandingkan dengan Canny\n","baris = []\n","for _, d in label.iterrows():\n","    img, md, mb = muat(d.nama_file)\n","    pra_ = praproses(img, PARAM)\n","    m_daun = mask_daun_awal(pra_)\n","    grad = cv2.morphologyEx(m_daun, cv2.MORPH_GRADIENT, SE(3))   # dilasi - erosi\n","    canny = tepi_canny(cv2.cvtColor(pra_, cv2.COLOR_BGR2GRAY))\n","    ad = tepi_acuan(md)\n","    baris.append([d.kondisi_cahaya, skor_tepi(grad, ad)[2], skor_tepi(canny, ad)[2]])\n","\n","print(pd.DataFrame(baris, columns=[\"kondisi\", \"F1 gradien morfologi\", \"F1 Canny\"])\n","      .groupby(\"kondisi\").mean().round(3))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"QaF1qpABqyR8","executionInfo":{"status":"ok","timestamp":1794985926028,"user_tz":-420,"elapsed":3509,"user":{"displayName":"Muhammad Aditya Genta Andhara","userId":"01260930399325567728"}},"outputId":"9ed94b9e-ccb9-4f04-fc0f-d8dd483363c0"},"execution_count":7,"outputs":[{"output_type":"stream","name":"stdout","text":["                F1 gradien morfologi  F1 Canny\n","kondisi                                       \n","bayangan                       0.970     0.712\n","gelap                          0.994     0.695\n","kontras_rendah                 0.666     0.906\n","normal                         0.991     0.685\n","terang                         0.982     0.690\n"]}]},{"cell_type":"code","source":["# Langkah 3.6 Visualisasi bentuk dan ukuran Structuring Element (SE)\n","bentuk_se = [\n","    (\"persegi\", cv2.MORPH_RECT),\n","    (\"elips\", cv2.MORPH_ELLIPSE),\n","    (\"silang\", cv2.MORPH_CROSS),\n","]\n","ukuran_se = [3, 5, 7]\n","\n","fig, axes = plt.subplots(3, 3, figsize=(10, 10))\n","for i, (nama_b, kode_b) in enumerate(bentuk_se):\n","    for j, uk in enumerate(ukuran_se):\n","        se = cv2.getStructuringElement(kode_b, (uk, uk))\n","        ax = axes[i, j]\n","        ax.imshow(se, cmap=\"gray\", vmin=0, vmax=1)\n","        ax.set_title(f\"{nama_b} {uk}x{uk} ({int(se.sum())} piksel)\")\n","        ax.set_xticks(np.arange(-0.5, uk, 1), minor=True)\n","        ax.set_yticks(np.arange(-0.5, uk, 1), minor=True)\n","        ax.grid(which=\"minor\", color=\"royalblue\", linestyle=\"-\", linewidth=1.2)\n","        ax.tick_params(which=\"both\", bottom=False, left=False, labelbottom=False, labelleft=False)\n","        for r in range(uk):\n","            for c in range(uk):\n","                ax.text(c, r, str(se[r, c]), ha=\"center\", va=\"center\",\n","                        color=\"black\" if se[r, c] == 1 else \"white\", fontsize=9, fontweight=\"bold\")\n","\n","plt.tight_layout()\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":885},"id":"GpCVEiOlq-ZB","executionInfo":{"status":"ok","timestamp":1794985939826,"user_tz":-420,"elapsed":2161,"user":{"displayName":"Muhammad Aditya Genta Andhara","userId":"01260930399325567728"}},"outputId":"aca58926-2012-460e-9ea1-2f04696d3a21"},"execution_count":8,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1000x1000 with 9 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","source":["BAGIAN 4: KOMPONEN TERHUBUNG DAN PENGUKURAN BERCAK"],"metadata":{"id":"jpVX7VeiyF-T"}},{"cell_type":"code","source":["# Kode 4.1 Komponen terhubung dan pengukuran setiap bercak\n","MM_PER_PX = 0.4375   # dari lembar hitung P2: Z = 200 mm, lebar kerja 640 px\n","\n","def ukur_komponen(m, konek=8):\n","    n, lbl, st, cen = cv2.connectedComponentsWithStats((m > 0).astype(np.uint8), connectivity=konek)\n","    baris = []\n","    for i in range(1, n):\n","        kontur, _ = cv2.findContours((lbl == i).astype(np.uint8), cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_NONE)\n","        A = int(st[i, cv2.CC_STAT_AREA])\n","        keliling = cv2.arcLength(kontur[0], True)\n","        kebulatan = 0.0 if keliling == 0 else 4 * np.pi * A / keliling ** 2\n","        w, h = cv2.minAreaRect(kontur[0])[1]\n","        rasio = max(w, h) / max(min(w, h), 1)\n","        baris.append([i, A, round(A * MM_PER_PX ** 2, 2), round(keliling, 1),\n","                      round(kebulatan, 2), round(rasio, 2), int(cen[i][0]), int(cen[i][1])])\n","    kolom = [\"label\", \"luas_px\", \"luas_mm2\", \"keliling_px\", \"kebulatan\", \"rasio_aspek\", \"cx\", \"cy\"]\n","    return pd.DataFrame(baris, columns=kolom), lbl\n","\n","img, md, mb = muat(\"teh_041.png\")\n","pra_ = praproses(img, PARAM)\n","m_daun = mask_daun_awal(pra_)\n","bersih = cv2.morphologyEx(cv2.morphologyEx(bercak_awal(pra_, m_daun), cv2.MORPH_OPEN, SE(5)),\n","                          cv2.MORPH_CLOSE, SE(5))\n","\n","for konek in [4, 8]:\n","    print(f\"konektivitas {konek}: {jumlah_komponen(bersih, konek)} komponen\")\n","\n","tabel_kom, lbl = ukur_komponen(bersih)\n","print(tabel_kom)\n","\n","warna = cv2.applyColorMap((lbl * (255 // max(lbl.max(), 1))).astype(np.uint8), cv2.COLORMAP_JET)\n","warna[lbl == 0] = pra_[lbl == 0]\n","for _, r in tabel_kom.iterrows():\n","    cv2.putText(warna, str(int(r.label)), (int(r.cx) + 8, int(r.cy)),\n","                cv2.FONT_HERSHEY_SIMPLEX, 0.5, (255, 255, 255), 2)\n","tampil([pra_, warna], [\"teh_041 sesudah praproses\", \"komponen berlabel\"], ukuran=(12, 4.5))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":574},"id":"9iGaHkFPyKCv","executionInfo":{"status":"ok","timestamp":1794985945946,"user_tz":-420,"elapsed":975,"user":{"displayName":"Muhammad Aditya Genta Andhara","userId":"01260930399325567728"}},"outputId":"e860da1e-77ca-4c99-a670-8727af343d1f"},"execution_count":9,"outputs":[{"output_type":"stream","name":"stdout","text":["konektivitas 4: 10 komponen\n","konektivitas 8: 10 komponen\n","   label  luas_px  luas_mm2  keliling_px  kebulatan  rasio_aspek   cx   cy\n","0      1      174     33.30         46.6       1.01         1.00  287  152\n","1      2      840    160.78        125.7       0.67         1.45  205  201\n","2      3      617    118.10         90.2       0.95         1.04  314  215\n","3      4      940    179.92        136.2       0.64         1.91  135  226\n","4      5       50      9.57         27.3       0.84         2.18  240  247\n","5      6      724    138.58         98.1       0.95         1.15  149  271\n","6      7      385     73.69         72.5       0.92         1.00  324  272\n","7      8       17      3.25         13.7       1.15         1.25  348  282\n","8      9      184     35.22         48.0       1.00         1.05  245  332\n","9     10      695    133.03         95.6       0.96         1.00  327  346\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1200x450 with 2 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["# Kode 4.2 Penyaringan komponen berdasarkan ukuran dan bentuk\n","def saring(m, luas_min=20, bulat_min=0.5, rasio_maks=1.8):\n","    tabel_k, lbl = ukur_komponen(m)\n","    lolos = tabel_k[(tabel_k.luas_px >= luas_min) & (tabel_k.kebulatan >= bulat_min)\n","                    & (tabel_k.rasio_aspek <= rasio_maks)]\n","    return (np.isin(lbl, lolos.label.values) * 255).astype(np.uint8), lolos\n","\n","aturan = {\"tanpa saring\": (0, 0, 99), \"luas >= 20\": (20, 0, 99),\n","          \"luas + kebulatan\": (20, 0.5, 99), \"luas + kebulatan + rasio\": (20, 0.5, 1.8)}\n","baris = []\n","for _, d in label.iterrows():\n","    img, md, mb = muat(d.nama_file)\n","    pra_ = praproses(img, PARAM)\n","    m_daun = mask_daun_awal(pra_)\n","    bersih = cv2.morphologyEx(cv2.morphologyEx(bercak_awal(pra_, m_daun), cv2.MORPH_OPEN, SE(5)),\n","                              cv2.MORPH_CLOSE, SE(5))\n","    for nm, (a, b, r) in aturan.items():\n","        f, _ = saring(bersih, a, b, r)\n","        baris.append([d.kelas, nm, jumlah_komponen(f), jumlah_komponen(mb)])\n","\n","uji = pd.DataFrame(baris, columns=[\"kelas\", \"aturan\", \"jumlah\", \"acuan\"])\n","uji[\"galat\"] = (uji.jumlah - uji.acuan).abs()\n","print(uji.pivot_table(index=\"aturan\", columns=\"kelas\", values=\"galat\").round(2))\n","print(\"Daun sehat yang masih memiliki bercak palsu:\")\n","print(uji[uji.kelas == \"sehat\"].assign(palsu=lambda t: t.jumlah > 0).groupby(\"aturan\").palsu.sum())"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"SQro-3UVz33t","executionInfo":{"status":"ok","timestamp":1794985955624,"user_tz":-420,"elapsed":4378,"user":{"displayName":"Muhammad Aditya Genta Andhara","userId":"01260930399325567728"}},"outputId":"75b3ede7-49e8-4f83-ce78-9551b2e0b5b1"},"execution_count":10,"outputs":[{"output_type":"stream","name":"stdout","text":["kelas                     berat  ringan  sehat\n","aturan                                        \n","luas + kebulatan           1.05    2.40   1.35\n","luas + kebulatan + rasio   1.00    1.30   0.70\n","luas >= 20                 1.55    3.70   2.50\n","tanpa saring               2.25    4.55   3.65\n","Daun sehat yang masih memiliki bercak palsu:\n","aturan\n","luas + kebulatan             9\n","luas + kebulatan + rasio     6\n","luas >= 20                  13\n","tanpa saring                14\n","Name: palsu, dtype: int64\n"]}]},{"cell_type":"code","source":["# Langkah 4.4 Dasar ambang penyaringan (diagram sebar komponen benar vs palsu)\n","data_kom = []\n","for _, d in label.iterrows():\n","    img, md, mb = muat(d.nama_file)\n","    pra_ = praproses(img, PARAM)\n","    m_daun = mask_daun_awal(pra_)\n","    bersih = cv2.morphologyEx(cv2.morphologyEx(bercak_awal(pra_, m_daun), cv2.MORPH_OPEN, SE(5)),\n","                              cv2.MORPH_CLOSE, SE(5))\n","    tabel_k, lbl = ukur_komponen(bersih)\n","    acuan_bin = (mb > 0)\n","    for _, r in tabel_k.iterrows():\n","        kom_bin = (lbl == int(r.label))\n","        irisan = (kom_bin & acuan_bin).sum()\n","        status = \"benar\" if irisan > 0.5 * r.luas_px else \"palsu\"\n","        data_kom.append([d.nama_file, d.kelas, int(r.label), r.luas_px,\n","                         r.kebulatan, r.rasio_aspek, status])\n","\n","df_kom = pd.DataFrame(data_kom, columns=[\"file\", \"kelas\", \"label\", \"luas_px\",\n","                                         \"kebulatan\", \"rasio_aspek\", \"status\"])\n","\n","print(\"Jumlah komponen per status:\", df_kom[\"status\"].value_counts().to_dict())\n","for st in [\"benar\", \"palsu\"]:\n","    sub = df_kom[df_kom.status == st][[\"luas_px\", \"kebulatan\", \"rasio_aspek\"]]\n","    print(f\"\\n--- Statistik Komponen {st.upper()} (n={len(sub)}) ---\")\n","    print(sub.quantile([0.0, 0.05, 0.5, 0.95, 1.0]).round(2))\n","\n","# Visualisasi diagram sebar\n","fig, axes = plt.subplots(1, 2, figsize=(14, 5.5))\n","\n","# Panel 1: Kebulatan vs Rasio Aspek (sesuai instruksi Langkah 4.4)\n","ax = axes[0]\n","for st, warna in [(\"palsu\", \"tab:red\"), (\"benar\", \"tab:blue\")]:\n","    sub_besar = df_kom[(df_kom.status == st) & (df_kom.luas_px >= 20)]\n","    sub_kecil = df_kom[(df_kom.status == st) & (df_kom.luas_px < 20)]\n","    ax.scatter(sub_besar.kebulatan, sub_besar.rasio_aspek, c=warna, marker=\"o\",\n","               alpha=0.75, edgecolors=\"k\", linewidth=0.4, label=f\"{st} (luas >= 20 px)\")\n","    ax.scatter(sub_kecil.kebulatan, sub_kecil.rasio_aspek, c=warna, marker=\"x\",\n","               s=45, alpha=0.85, label=f\"{st} (luas < 20 px)\")\n","\n","ax.axvline(0.5, color=\"darkgreen\", linestyle=\"--\", linewidth=1.3, label=\"bulat_min = 0.5\")\n","ax.axhline(1.8, color=\"darkorange\", linestyle=\"--\", linewidth=1.3, label=\"rasio_maks = 1.8\")\n","ax.set_xlabel(\"Kebulatan\")\n","ax.set_ylabel(\"Rasio Aspek\")\n","ax.set_title(\"Diagram Sebar Kebulatan vs Rasio Aspek (60 Citra)\")\n","ax.grid(True, linestyle=\":\", alpha=0.5)\n","ax.legend(fontsize=8, loc=\"upper right\")\n","\n","# Panel 2: Luas (px) vs Kebulatan untuk melihat batas luas_min = 20\n","ax2 = axes[1]\n","for st, warna in [(\"palsu\", \"tab:red\"), (\"benar\", \"tab:blue\")]:\n","    sub = df_kom[df_kom.status == st]\n","    ax2.scatter(sub.luas_px, sub.kebulatan, c=warna, alpha=0.75,\n","                edgecolors=\"k\", linewidth=0.4, label=f\"komponen {st}\")\n","\n","ax2.axvline(20, color=\"purple\", linestyle=\"--\", linewidth=1.3, label=\"luas_min = 20 px\")\n","ax2.axhline(0.5, color=\"darkgreen\", linestyle=\"--\", linewidth=1.3, label=\"bulat_min = 0.5\")\n","ax2.set_xscale(\"log\")\n","ax2.set_xlabel(\"Luas Piksel (skala log)\")\n","ax2.set_ylabel(\"Kebulatan\")\n","ax2.set_title(\"Sebaran Luas Piksel vs Kebulatan\")\n","ax2.grid(True, which=\"both\", linestyle=\":\", alpha=0.5)\n","ax2.legend(fontsize=8, loc=\"lower right\")\n","\n","plt.tight_layout()\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":641},"id":"NmX56h_t1VwE","executionInfo":{"status":"ok","timestamp":1794985961258,"user_tz":-420,"elapsed":3433,"user":{"displayName":"Muhammad Aditya Genta Andhara","userId":"01260930399325567728"}},"outputId":"99b116ca-4467-483e-a34e-18e0f817a454"},"execution_count":11,"outputs":[{"output_type":"stream","name":"stdout","text":["Jumlah komponen per status: {'palsu': 207, 'benar': 202}\n","\n","--- Statistik Komponen BENAR (n=202) ---\n","      luas_px  kebulatan  rasio_aspek\n","0.00     17.0       0.17         1.00\n","0.05     43.6       0.64         1.00\n","0.50    269.5       0.97         1.04\n","0.95    723.4       1.08         1.77\n","1.00   1283.0       1.15         4.10\n","\n","--- Statistik Komponen PALSU (n=207) ---\n","      luas_px  kebulatan  rasio_aspek\n","0.00      1.0       0.00         0.00\n","0.05     17.0       0.07         1.25\n","0.50     36.0       0.89         1.93\n","0.95    662.3       1.15        20.59\n","1.00   1966.0       1.15        60.25\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1400x550 with 2 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["luas_acuan = int((mb > 0).sum())\n","luas_hasil = 4559  # total luas 8 bercak setelah saring (atau 4626 sebelum saring)\n","print(f\"Luas acuan: {luas_acuan} px | Selisih: {abs(luas_acuan - luas_hasil) / luas_acuan * 100:.2f}%\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"tL5yW-iB4Cyp","executionInfo":{"status":"ok","timestamp":1794985967572,"user_tz":-420,"elapsed":134,"user":{"displayName":"Muhammad Aditya Genta Andhara","userId":"01260930399325567728"}},"outputId":"dd81f846-57f1-408a-a250-970f955d8ced"},"execution_count":12,"outputs":[{"output_type":"stream","name":"stdout","text":["Luas acuan: 3899 px | Selisih: 16.93%\n"]}]},{"cell_type":"code","source":["%%writefile /content/drive/MyDrive/simuteh-2330511092/src/bercak.py\n","\"\"\"bercak.py: analisis bercak SIMUTEH (dipakai ulang mulai P7).\"\"\"\n","import json\n","import cv2\n","import numpy as np\n","from utils_tepi import mask_daun_awal, bercak_awal\n","\n","PARAM_BERCAK = {\n","    \"kanal\": 2,             # kanal terpilih (2 = R)\n","    \"k\": 4.0,               # ambang median + k x MAD\n","    \"se_bentuk\": \"elips\",   # \"elips\", \"persegi\", \"silang\"\n","    \"se_open\": 5,           # ukuran SE opening (0 = tidak dipakai)\n","    \"se_close\": 5,          # ukuran SE closing (0 = tidak dipakai)\n","    \"luas_min\": 20,         # piksel\n","    \"bulat_min\": 0.5,\n","    \"rasio_maks\": 1.8,\n","    \"batas_ringan\": 0.1,    # persen bercak minimum kelas Ringan\n","    \"batas_berat\": 2.0,     # persen bercak minimum kelas Berat\n","    \"mm_per_px\": 0.4375,\n","}\n","_BENTUK = {\"elips\": cv2.MORPH_ELLIPSE, \"persegi\": cv2.MORPH_RECT, \"silang\": cv2.MORPH_CROSS}\n","\n","\n","def _se(p, uk):\n","    return cv2.getStructuringElement(_BENTUK[p[\"se_bentuk\"]], (uk, uk))\n","\n","\n","def bersihkan(biner, p):\n","    \"\"\"Opening membuang titik derau dan potongan tipis; closing menutup celah.\"\"\"\n","    # TODO 1: bila p[\"se_open\"] > 0, lakukan opening dengan SE _se(p, p[\"se_open\"])\n","    if p[\"se_open\"] > 0:\n","        biner = cv2.morphologyEx(biner, cv2.MORPH_OPEN, _se(p, p[\"se_open\"]))\n","    # TODO 2: bila p[\"se_close\"] > 0, lakukan closing dengan SE _se(p, p[\"se_close\"])\n","    if p[\"se_close\"] > 0:\n","        biner = cv2.morphologyEx(biner, cv2.MORPH_CLOSE, _se(p, p[\"se_close\"]))\n","    return biner\n","\n","\n","def ukur_dan_saring(biner, p):\n","    \"\"\"Mengembalikan mask bercak tersaring dan daftar ukuran setiap bercak.\"\"\"\n","    # TODO 3: label komponen terhubung (konektivitas 8) dengan cv2.connectedComponentsWithStats\n","    n, lbl, st, cen = cv2.connectedComponentsWithStats((biner > 0).astype(np.uint8), connectivity=8)\n","    keluar, daftar = np.zeros_like(biner, dtype=np.uint8), []\n","\n","    for i in range(1, n):\n","        # TODO 4: untuk setiap komponen hitung luas, keliling (cv2.arcLength),\n","        #         kebulatan 4*pi*luas/keliling^2, dan rasio aspek (cv2.minAreaRect)\n","        kontur, _ = cv2.findContours((lbl == i).astype(np.uint8), cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_NONE)\n","        if not kontur:\n","            continue\n","        A = int(st[i, cv2.CC_STAT_AREA])\n","        keliling = cv2.arcLength(kontur[0], True)\n","        kebulatan = 0.0 if keliling == 0 else 4 * np.pi * A / (keliling ** 2)\n","        w, h = cv2.minAreaRect(kontur[0])[1]\n","        rasio = max(w, h) / max(min(w, h), 1)\n","\n","        # TODO 5: simpan ke mask keluar hanya komponen yang memenuhi luas_min,\n","        #         bulat_min, dan rasio_maks; catat ukurannya ke daftar\n","        if A >= p[\"luas_min\"] and kebulatan >= p[\"bulat_min\"] and rasio <= p[\"rasio_maks\"]:\n","            keluar[lbl == i] = 255\n","            daftar.append({\n","                \"label\": len(daftar) + 1,\n","                \"luas_px\": A,\n","                \"luas_mm2\": round(A * (p[\"mm_per_px\"] ** 2), 2),\n","                \"keliling_px\": round(float(keliling), 1),\n","                \"kebulatan\": round(float(kebulatan), 2),\n","                \"rasio_aspek\": round(float(rasio), 2),\n","                \"cx\": int(cen[i][0]),\n","                \"cy\": int(cen[i][1]),\n","            })\n","\n","    return keluar, daftar\n","\n","\n","def analisis_daun(img_praproses, p=None):\n","    \"\"\"Masukan: citra BGR hasil praproses. Keluaran: kamus hasil analisis.\"\"\"\n","    p = {**PARAM_BERCAK, **(p or {})}\n","    m_daun = mask_daun_awal(img_praproses)\n","    biner = bercak_awal(img_praproses, m_daun, kanal=p[\"kanal\"], k=p[\"k\"])\n","    m_bercak, daftar = ukur_dan_saring(bersihkan(biner, p), p)\n","\n","    # TODO 6: hitung persen bercak = luas bercak / luas daun x 100\n","    luas_daun = int((m_daun > 0).sum())\n","    luas_bercak = int((m_bercak > 0).sum())\n","    persen = (luas_bercak / luas_daun * 100.0) if luas_daun > 0 else 0.0\n","\n","    # TODO 7: tentukan kelas dengan batas_ringan dan batas_berat\n","    if persen >= p[\"batas_berat\"]:\n","        kelas = \"Bercak Berat\"\n","    elif persen >= p[\"batas_ringan\"]:\n","        kelas = \"Bercak Ringan\"\n","    else:\n","        kelas = \"Sehat\"\n","\n","    return {\n","        \"mask_daun\": m_daun,\n","        \"mask_bercak\": m_bercak,\n","        \"jumlah_bercak\": len(daftar),\n","        \"persen_bercak\": round(float(persen), 3),\n","        \"kelas\": kelas,\n","        \"bercak\": daftar,\n","    }\n","\n","\n","def simpan_param(p, path=\"/content/drive/MyDrive/simuteh-2330511092/hasil/param_bercak.json\"):\n","    with open(path, \"w\") as f:\n","        json.dump({**PARAM_BERCAK, **p}, f, indent=2)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"xQmI6mcU6OIc","executionInfo":{"status":"ok","timestamp":1794985971109,"user_tz":-420,"elapsed":247,"user":{"displ